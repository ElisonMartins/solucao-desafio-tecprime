{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "rootDir": "./",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "scripts/**/*"]
}