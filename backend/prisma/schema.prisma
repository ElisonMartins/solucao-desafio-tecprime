//Prisma7 não necessita mais da url do banco de dados no arquivo .env, mas sim na configuração do datasource no schema.prisma.  
//Mas o vscode exibe erro, no entanto, a migração ocorre normalmente.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  cart      Cart?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          Int      @id
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  image       String
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(uuid())
  cart      Cart   @relation(fields: [cartId], references: [id])
  cartId    String
  productId Int
  quantity  Int
}

model Order {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  name  String
  email String

  street       String
  number       String
  neighborhood String
  city         String
  state        String
  cep          String
  complement   String?

  paymentMethod String
  total         Decimal @db.Decimal(10, 2)

  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
}
